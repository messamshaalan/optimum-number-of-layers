//@version=5
// XAUUSD Price Action Strategy
// Ported from Python backtester (xauusd-backtest)
// Run on: XAUUSD 5-minute chart
//
// Logic:
//   - Pin bar and/or engulfing on 15M / 5M / 1M (multi-TF via request.security)
//   - EMA50 trend filter on 15M gates the 15M vote
//   - ADX regime on 15M: TRENDING / RANGING / TRANSITIONING
//   - Session-aware: Asia/LondonOpen/London/Overlap allowed; NY+Rollover blocked
//   - LondonOpen requires all 3 TF agreement
//   - Session-specific TP multipliers × ATR
//   - Breakeven alert fires when price moves 1R in favour

strategy("XAUUSD PA Strategy", shorttitle="PA_XAUUSD",
         overlay=true, pyramiding=0,
         default_qty_type=strategy.fixed, default_qty_value=1,
         commission_type=strategy.commission.cash_per_contract,
         commission_value=0.30,
         initial_capital=10000,
         currency=currency.USD)

// ─────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────
var float RISK_USD          = input.float(100.0,   "Risk per trade (USD)",    minval=1)
var int   ATR_PERIOD        = input.int  (14,       "ATR period",              minval=1)
var float SL_ATR_MULT       = input.float(1.5,      "SL ATR multiplier",      minval=0.5)
var float BASE_RR           = input.float(2.5,      "Base R:R",               minval=1.0)
var int   EMA_PERIOD        = input.int  (50,       "EMA trend period (15M)", minval=5)
var int   ADX_PERIOD        = input.int  (14,       "ADX period (15M)",       minval=2)
var float ADX_TREND         = input.float(25.0,     "ADX trend threshold")
var float ADX_RANGE         = input.float(20.0,     "ADX range threshold")
var float MIN_CONF          = input.float(0.72,     "Min confidence",         minval=0.0, maxval=1.0)
var float PIN_RATIO         = input.float(2.0,      "Pin bar wick/body ratio",minval=1.0)
var float PIN_BODY_PCT      = input.float(0.30,     "Pin bar max body%",      minval=0.05, maxval=0.80)
var float TP_ASIA           = input.float(3.5,      "TP mult Asia")
var float TP_LONDON_OPEN    = input.float(2.0,      "TP mult LondonOpen")
var float TP_LONDON         = input.float(2.5,      "TP mult London")
var float TP_OVERLAP        = input.float(3.0,      "TP mult Overlap")
var float REGIME_TREND_BONUS = input.float(0.20,    "Regime TRENDING bonus")
var float REGIME_RANGE_PENALTY = input.float(0.10,  "Regime RANGING penalty")
var int   MAX_ASIA          = input.int  (8,        "Max trades Asia/day")
var int   MAX_LONDON_OPEN   = input.int  (2,        "Max trades LondonOpen/day")
var int   MAX_LONDON        = input.int  (3,        "Max trades London/day")
var int   MAX_OVERLAP       = input.int  (3,        "Max trades Overlap/day")
var int   COOLDOWN_ASIA         = input.int(15, "Cooldown Asia (min)")
var int   COOLDOWN_LONDON_OPEN  = input.int(45, "Cooldown LondonOpen (min)")
var int   COOLDOWN_LONDON       = input.int(30, "Cooldown London (min)")
var int   COOLDOWN_OVERLAP      = input.int(30, "Cooldown Overlap (min)")

var bool  SHOW_SESSION_BG   = input.bool(true,  "Show session background")
var bool  SHOW_TABLE        = input.bool(true,  "Show info table")

// ─────────────────────────────────────────────────────────────────
// SESSION DETECTION  (UTC)
// ─────────────────────────────────────────────────────────────────
h_utc = hour(time, "UTC")

SESSION_ASIA        = 0   // 0–7 UTC
SESSION_LONDON_OPEN = 1   // 7–9 UTC
SESSION_LONDON      = 2   // 9–12 UTC
SESSION_OVERLAP     = 3   // 12–14 UTC
SESSION_NY          = 4   // 14–17 UTC
SESSION_ROLLOVER    = 5   // 17–24 UTC

f_session() =>
    if h_utc >= 0 and h_utc < 7
        SESSION_ASIA
    else if h_utc >= 7 and h_utc < 9
        SESSION_LONDON_OPEN
    else if h_utc >= 9 and h_utc < 12
        SESSION_LONDON
    else if h_utc >= 12 and h_utc < 14
        SESSION_OVERLAP
    else if h_utc >= 14 and h_utc < 17
        SESSION_NY
    else
        SESSION_ROLLOVER

cur_session = f_session()
is_blocked  = (cur_session == SESSION_NY or cur_session == SESSION_ROLLOVER)

// ─────────────────────────────────────────────────────────────────
// SESSION DAILY COUNTERS  (reset on new calendar day UTC)
// ─────────────────────────────────────────────────────────────────
var int cnt_asia       = 0
var int cnt_londonopen = 0
var int cnt_london     = 0
var int cnt_overlap    = 0

var int last_day       = -1

new_day = dayofweek(time, "UTC") != last_day or (dayofweek(time, "UTC") == last_day and h_utc == 0 and minute(time, "UTC") == 0 and last_day != dayofmonth(time, "UTC"))

// Simpler: reset when date changes
cur_day = dayofmonth(time, "UTC") * 100 + month(time, "UTC")
var int prev_day_key = -1
if cur_day != prev_day_key
    cnt_asia       := 0
    cnt_londonopen := 0
    cnt_london     := 0
    cnt_overlap    := 0
    prev_day_key   := cur_day

// ─────────────────────────────────────────────────────────────────
// SESSION COOLDOWN
// ─────────────────────────────────────────────────────────────────
var int last_bar_asia       = -9999
var int last_bar_londonopen = -9999
var int last_bar_london     = -9999
var int last_bar_overlap    = -9999

bars_per_min  = 1.0 / timeframe.in_seconds() * 60  // bars per minute (on 5M = 0.2)

f_cooldown_ok(sess) =>
    if sess == SESSION_ASIA
        (bar_index - last_bar_asia) >= int(COOLDOWN_ASIA * bars_per_min)
    else if sess == SESSION_LONDON_OPEN
        (bar_index - last_bar_londonopen) >= int(COOLDOWN_LONDON_OPEN * bars_per_min)
    else if sess == SESSION_LONDON
        (bar_index - last_bar_london) >= int(COOLDOWN_LONDON * bars_per_min)
    else if sess == SESSION_OVERLAP
        (bar_index - last_bar_overlap) >= int(COOLDOWN_OVERLAP * bars_per_min)
    else
        true

f_cap_ok(sess) =>
    if sess == SESSION_ASIA
        cnt_asia < MAX_ASIA
    else if sess == SESSION_LONDON_OPEN
        cnt_londonopen < MAX_LONDON_OPEN
    else if sess == SESSION_LONDON
        cnt_london < MAX_LONDON
    else if sess == SESSION_OVERLAP
        cnt_overlap < MAX_OVERLAP
    else
        false

// ─────────────────────────────────────────────────────────────────
// INDICATORS (current timeframe = 5M, plus 15M and 1M via security)
// ─────────────────────────────────────────────────────────────────

// ATR on 5M
atr_5m = ta.atr(ATR_PERIOD)

// EMA50 on 15M
ema_15m = request.security(syminfo.tickerid, "15", ta.ema(close, EMA_PERIOD), lookahead=barmerge.lookahead_off)

// ADX on 15M (manual Wilder smoothing to avoid dependency on built-ins)
[di_plus_15m, di_minus_15m, adx_15m] = request.security(syminfo.tickerid, "15",
    ta.dmi(ADX_PERIOD, ADX_PERIOD), lookahead=barmerge.lookahead_off)

// Regime
regime_trending      = adx_15m > ADX_TREND
regime_ranging       = adx_15m < ADX_RANGE
regime_transitioning = not regime_trending and not regime_ranging
regime_str = regime_trending ? "TRENDING" : regime_ranging ? "RANGING" : "TRANSIT"

// ─────────────────────────────────────────────────────────────────
// PATTERN DETECTION FUNCTIONS
// ─────────────────────────────────────────────────────────────────

f_bull_pin(o, h, l, c) =>
    body       = math.abs(c - o)
    total      = h - l
    lower_wick = math.min(o, c) - l
    total > 1e-9 and (body / total) <= PIN_BODY_PCT and lower_wick >= PIN_RATIO * math.max(body, 0.001)

f_bear_pin(o, h, l, c) =>
    body       = math.abs(c - o)
    total      = h - l
    upper_wick = h - math.max(o, c)
    total > 1e-9 and (body / total) <= PIN_BODY_PCT and upper_wick >= PIN_RATIO * math.max(body, 0.001)

f_bull_eng(o1, c1, o2, c2) =>
    // bar1=prior bearish, bar2=current bullish engulfing
    c1 < o1 and c2 > o2 and c2 >= math.max(o1, c1) and o2 <= math.min(o1, c1) and math.abs(c2 - o2) > math.abs(c1 - o1)

f_bear_eng(o1, c1, o2, c2) =>
    // bar1=prior bullish, bar2=current bearish engulfing
    c1 > o1 and c2 < o2 and c2 <= math.min(o1, c1) and o2 >= math.max(o1, c1) and math.abs(c2 - o2) > math.abs(c1 - o1)

// Pin quality = lower/upper wick as fraction of total range
f_pin_qual(o, h, l, c, is_bull) =>
    total = h - l
    if total < 1e-9
        0.0
    else if is_bull
        (math.min(o, c) - l) / total
    else
        (h - math.max(o, c)) / total

// Engulfing quality = excess body ratio - 1
f_eng_qual(o1, c1, o2, c2) =>
    b1 = math.abs(c1 - o1)
    b2 = math.abs(c2 - o2)
    math.min(b2 / math.max(b1, 0.001) - 1.0, 1.0)

// ─────────────────────────────────────────────────────────────────
// PER-TIMEFRAME VOTE COMPUTATION
// ─────────────────────────────────────────────────────────────────

// Returns [vote, quality] for a given timeframe
// vote: 1=BUY, -1=SELL, 0=none
f_pa_vote(tf_str, apply_ema_filter) =>
    _o1 = request.security(syminfo.tickerid, tf_str, open [1], lookahead=barmerge.lookahead_off)
    _h1 = request.security(syminfo.tickerid, tf_str, high [1], lookahead=barmerge.lookahead_off)
    _l1 = request.security(syminfo.tickerid, tf_str, low  [1], lookahead=barmerge.lookahead_off)
    _c1 = request.security(syminfo.tickerid, tf_str, close[1], lookahead=barmerge.lookahead_off)
    _o2 = request.security(syminfo.tickerid, tf_str, open [2], lookahead=barmerge.lookahead_off)
    _h2 = request.security(syminfo.tickerid, tf_str, high [2], lookahead=barmerge.lookahead_off)
    _l2 = request.security(syminfo.tickerid, tf_str, low  [2], lookahead=barmerge.lookahead_off)
    _c2 = request.security(syminfo.tickerid, tf_str, close[2], lookahead=barmerge.lookahead_off)

    bp1 = f_bull_pin(_o1, _h1, _l1, _c1)
    bp2 = f_bull_pin(_o2, _h2, _l2, _c2)
    brp1 = f_bear_pin(_o1, _h1, _l1, _c1)
    brp2 = f_bear_pin(_o2, _h2, _l2, _c2)
    be  = f_bull_eng(_o2, _c2, _o1, _c1)
    bre = f_bear_eng(_o2, _c2, _o1, _c1)

    has_bull = bp1 or bp2 or be
    has_bear = brp1 or brp2 or bre

    vote = 0
    qual = 0.0

    if has_bull and not has_bear
        vote := 1
        qual := bp1 ? f_pin_qual(_o1,_h1,_l1,_c1, true) : bp2 ? f_pin_qual(_o2,_h2,_l2,_c2, true) : f_eng_qual(_o2,_c2,_o1,_c1)
    else if has_bear and not has_bull
        vote := -1
        qual := brp1 ? f_pin_qual(_o1,_h1,_l1,_c1, false) : brp2 ? f_pin_qual(_o2,_h2,_l2,_c2, false) : f_eng_qual(_o2,_c2,_o1,_c1)

    // EMA50 trend filter for 15M
    if apply_ema_filter and vote != 0
        above_ema = _c1 > ema_15m
        if vote == 1 and not above_ema
            vote := 0
        if vote == -1 and above_ema
            vote := 0

    [vote, qual]

[v15, q15] = f_pa_vote("15", true)
[v5,  q5 ] = f_pa_vote("5",  false)
[v1,  q1 ] = f_pa_vote("1",  false)

// ─────────────────────────────────────────────────────────────────
// CONFLUENCE SCORE
// ─────────────────────────────────────────────────────────────────

bull_votes  = (v15 == 1 ? 1 : 0) + (v5 == 1 ? 1 : 0) + (v1 == 1 ? 1 : 0)
bear_votes  = (v15 == -1 ? 1 : 0) + (v5 == -1 ? 1 : 0) + (v1 == -1 ? 1 : 0)

signal_dir  = bull_votes > bear_votes ? 1 : bear_votes > bull_votes ? -1 : 0
agree_count = signal_dir == 1 ? bull_votes : signal_dir == -1 ? bear_votes : 0

avg_qual = agree_count > 0 ?
    (signal_dir == 1 ?
        ((v15==1 ? q15 : 0.0) + (v5==1 ? q5 : 0.0) + (v1==1 ? q1 : 0.0)) / agree_count :
        ((v15==-1 ? q15 : 0.0) + (v5==-1 ? q5 : 0.0) + (v1==-1 ? q1 : 0.0)) / agree_count) : 0.0

confidence_raw = math.min(0.45 + 0.20 * agree_count, 1.0)
confidence_raw := math.min(confidence_raw + 0.10 * avg_qual, 1.0)
confidence = regime_transitioning ? confidence_raw * 0.90 : confidence_raw

// ─────────────────────────────────────────────────────────────────
// SIGNAL GATING
// ─────────────────────────────────────────────────────────────────

// LondonOpen strict: all 3 TF must agree
londonopen_ok = cur_session == SESSION_LONDON_OPEN ? agree_count >= 3 : true

signal_valid = signal_dir != 0 and
               confidence >= MIN_CONF and
               not is_blocked and
               f_cap_ok(cur_session) and
               f_cooldown_ok(cur_session) and
               londonopen_ok

// ─────────────────────────────────────────────────────────────────
// TP MULTIPLIER
// ─────────────────────────────────────────────────────────────────

f_tp_mult(sess) =>
    mult = sess == SESSION_ASIA       ? TP_ASIA :
           sess == SESSION_LONDON_OPEN ? TP_LONDON_OPEN :
           sess == SESSION_LONDON      ? TP_LONDON :
           sess == SESSION_OVERLAP     ? TP_OVERLAP : BASE_RR
    mult := regime_trending ? mult * (1 + REGIME_TREND_BONUS) : mult
    mult := regime_ranging  ? mult * (1 - REGIME_RANGE_PENALTY) : mult
    mult

tp_mult = f_tp_mult(cur_session)

// ─────────────────────────────────────────────────────────────────
// ENTRY LOGIC
// ─────────────────────────────────────────────────────────────────

sl_dist = SL_ATR_MULT * atr_5m
tp_dist = tp_mult * atr_5m

long_signal  = signal_valid and signal_dir == 1
short_signal = signal_valid and signal_dir == -1

if long_signal
    strategy.entry("Long", strategy.long)
    strategy.exit("Long_Exit", from_entry="Long",
                  stop  = close - sl_dist,
                  limit = close + tp_dist)
    // Update counters
    if cur_session == SESSION_ASIA
        cnt_asia := cnt_asia + 1
        last_bar_asia := bar_index
    else if cur_session == SESSION_LONDON_OPEN
        cnt_londonopen := cnt_londonopen + 1
        last_bar_londonopen := bar_index
    else if cur_session == SESSION_LONDON
        cnt_london := cnt_london + 1
        last_bar_london := bar_index
    else if cur_session == SESSION_OVERLAP
        cnt_overlap := cnt_overlap + 1
        last_bar_overlap := bar_index

if short_signal
    strategy.entry("Short", strategy.short)
    strategy.exit("Short_Exit", from_entry="Short",
                  stop  = close + sl_dist,
                  limit = close - tp_dist)
    if cur_session == SESSION_ASIA
        cnt_asia := cnt_asia + 1
        last_bar_asia := bar_index
    else if cur_session == SESSION_LONDON_OPEN
        cnt_londonopen := cnt_londonopen + 1
        last_bar_londonopen := bar_index
    else if cur_session == SESSION_LONDON
        cnt_london := cnt_london + 1
        last_bar_london := bar_index
    else if cur_session == SESSION_OVERLAP
        cnt_overlap := cnt_overlap + 1
        last_bar_overlap := bar_index

// ─────────────────────────────────────────────────────────────────
// BREAKEVEN ALERT
// TradingView strategies can't dynamically modify stops; fire an alert
// so the trader/webhook handler knows to move SL to entry.
// ─────────────────────────────────────────────────────────────────

var float last_long_entry  = na
var float last_short_entry = na
var float last_long_sl     = na
var float last_short_sl    = na

if long_signal
    last_long_entry := close
    last_long_sl    := sl_dist

if short_signal
    last_short_entry := close
    last_short_sl    := sl_dist

be_long_trigger  = not na(last_long_entry)  and strategy.position_size > 0  and high  >= last_long_entry  + last_long_sl
be_short_trigger = not na(last_short_entry) and strategy.position_size < 0  and low   <= last_short_entry - last_short_sl

alertcondition(be_long_trigger,  "Breakeven Long",  "Move Long SL to entry {{close}}")
alertcondition(be_short_trigger, "Breakeven Short", "Move Short SL to entry {{close}}")

// ─────────────────────────────────────────────────────────────────
// VISUALS
// ─────────────────────────────────────────────────────────────────

// Session background
bg_col = SHOW_SESSION_BG ?
    (cur_session == SESSION_ASIA        ? color.new(color.blue,   90) :
     cur_session == SESSION_LONDON_OPEN ? color.new(color.green,  85) :
     cur_session == SESSION_LONDON      ? color.new(color.teal,   90) :
     cur_session == SESSION_OVERLAP     ? color.new(color.orange, 90) :
     cur_session == SESSION_NY          ? color.new(color.red,    93) :
     color.new(color.gray, 95)) : na

bgcolor(bg_col, title="Session background")

// EMA50 line (15M value plotted on current TF)
plot(ema_15m, "EMA50 (15M)", color=color.yellow, linewidth=2)

// Signal arrows
plotshape(long_signal,  style=shape.triangleup,   location=location.belowbar, color=color.lime,  size=size.small, title="Long Signal")
plotshape(short_signal, style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small, title="Short Signal")

// SL / TP levels on signal bars
if long_signal
    line.new(bar_index, close - sl_dist, bar_index + 10, close - sl_dist, color=color.red,   width=1, style=line.style_dashed)
    line.new(bar_index, close + tp_dist, bar_index + 10, close + tp_dist, color=color.green, width=1, style=line.style_dashed)

if short_signal
    line.new(bar_index, close + sl_dist, bar_index + 10, close + sl_dist, color=color.red,   width=1, style=line.style_dashed)
    line.new(bar_index, close - tp_dist, bar_index + 10, close - tp_dist, color=color.green, width=1, style=line.style_dashed)

// ─────────────────────────────────────────────────────────────────
// INFO TABLE
// ─────────────────────────────────────────────────────────────────

sess_name = cur_session == SESSION_ASIA        ? "Asia" :
            cur_session == SESSION_LONDON_OPEN ? "LondonOpen" :
            cur_session == SESSION_LONDON      ? "London" :
            cur_session == SESSION_OVERLAP     ? "Overlap" :
            cur_session == SESSION_NY          ? "NY [blocked]" : "Rollover [blocked]"

if SHOW_TABLE and barstate.islast
    var table t = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 70), border_width=1)
    table.cell(t, 0, 0, "Session",    text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 0, sess_name,    text_color=color.white, text_size=size.small)
    table.cell(t, 0, 1, "Regime",     text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 1, regime_str,   text_color=regime_trending ? color.lime : regime_ranging ? color.orange : color.yellow, text_size=size.small)
    table.cell(t, 0, 2, "ADX",        text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 2, str.tostring(adx_15m, "#.1"), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 3, "Confidence", text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 3, str.tostring(confidence, "#.##"), text_color=confidence >= MIN_CONF ? color.lime : color.red, text_size=size.small)
    table.cell(t, 0, 4, "Votes 15/5/1", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 4, str.tostring(v15) + " / " + str.tostring(v5) + " / " + str.tostring(v1), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 5, "ATR",        text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 5, str.tostring(atr_5m, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 6, "SL / TP",    text_color=color.gray,  text_size=size.small)
    table.cell(t, 1, 6, str.tostring(sl_dist, "#.##") + " / " + str.tostring(tp_dist, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 7, "EMA50 (15M)", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 7, str.tostring(ema_15m, "#.##"), text_color=color.yellow, text_size=size.small)
