; XAUUSD_PA_EA v1.02 — Optimised settings
; Based on 2016-2019 Python backtest + live test report analysis
;
; Test report findings that drove changes:
;   - Win rate was 27% (vs 52% on synthetic data)
;     → real XAUUSD has more noise; tighten entry criteria
;   - 53% max drawdown; 23 consecutive losses
;     → RANGING regime was being traded; hard block added
;   - Profit factor 1.01 (barely alive)
;     → SL too tight (1.5xATR) — widened to 2.0 to survive tick noise
;   - 1,441 trades — over-trading on low-quality signals
;     → session caps halved, cooldowns extended
;
; Target: win rate ~38-42%, profit factor ~1.30+, max DD < 25%

[expert]

[inputs]
; ── Risk sizing ──────────────────────────────────────────────────
; Use 1% of balance — scales automatically as account grows/shrinks
InpUseRiskPercent=true
InpRiskPercent=1.0
InpRiskUSD=100.0

; ── Core indicator periods ───────────────────────────────────────
InpATRPeriod=14
InpEMAPeriod=50
InpADXPeriod=14

; ── ATR-based SL/TP ──────────────────────────────────────────────
; Widened from 1.5 to 2.0: real XAUUSD tick noise was clipping the
; 1.5x SL before moves developed. 2.0x gives trades room to breathe.
; TP is set per-session (below), not by BaseRR; BaseRR only used as
; fallback for unlisted sessions.
InpSLATRMult=2.0
InpBaseRR=2.5

; ── ADX regime thresholds ────────────────────────────────────────
; Raised trend threshold to 28 — only trade in clearly trending markets.
; Range threshold kept at 20; combined with BlockRanging=true this
; means we only trade when ADX >= 28 (TRENDING only, no TRANSITIONING).
; If you want TRANSITIONING trades too, lower ADXTrend back to 25.
InpADXTrend=28.0
InpADXRange=20.0

; ── Regime guards (NEW in v1.02) ─────────────────────────────────
; Hard block all entries when ADX < 20 (ranging conditions).
; This was the single biggest cause of losing streaks in the live test.
InpBlockRanging=true

; ── Daily risk controls (NEW in v1.02) ───────────────────────────
; Stop trading after 4 consecutive SL hits — likely a regime shift.
; Stop trading for the day if equity drops 3% intraday.
InpMaxConsecLosses=4
InpMaxDailyLossPC=3.0

; ── Signal quality ───────────────────────────────────────────────
; Raised confidence from 0.72 to 0.80:
;   0.72 allowed weak 2/3-TF signals with low quality score through.
;   0.80 requires either strong 2/3-TF quality OR any 3/3-TF agreement.
InpMinConfidence=0.80
; Stricter pin bars: wick must be 2.5x the body (was 2.0x)
InpPinRatio=2.5
; Stricter pin bars: body must be ≤22% of range (was 30%)
InpPinBodyPct=0.22

; ── Session TP multipliers (× ATR) ──────────────────────────────
; Multiplied by wider SL (2.0x) these still give good net RR:
;   Asia:        4.0 / 2.0 = 2.0 R net
;   LondonOpen:  2.0 / 2.0 = 1.0 R net  (volatile — tight target)
;   London:      3.0 / 2.0 = 1.5 R net
;   Overlap:     3.5 / 2.0 = 1.75 R net
InpTPAsia=4.0
InpTPLondonOpen=2.0
InpTPLondon=3.0
InpTPOverlap=3.5

; ── Regime TP adjustments ────────────────────────────────────────
InpRegimeTrendBonus=0.20
InpRegimeRangePenalty=0.10

; ── Session daily trade caps ─────────────────────────────────────
; Halved from previous settings — fewer but higher quality entries.
; Asia remains primary session (best edge in backtesting).
InpMaxAsia=4
InpMaxLondonOpen=1
InpMaxLondon=2
InpMaxOverlap=1

; ── Session cooldown minutes ─────────────────────────────────────
; Extended to force patience between entries.
InpCooldownAsia=30
InpCooldownLondonOpen=60
InpCooldownLondon=45
InpCooldownOverlap=60

; ── EA identity ──────────────────────────────────────────────────
InpMagicNumber=202600
